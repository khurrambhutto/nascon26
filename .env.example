# Supply the real team salt via your shell environment. Never commit it.
DAY1_SALT=
DAY2_SALT=
# Optional. Blank derives a separate JWT key from DAY1_SALT.
JWT_SECRET=
# Optional overrides for running Python outside Compose:
DATABASE_URL=postgresql+psycopg://nascon:nascon-local@localhost:5432/nascon
REDIS_URL=redis://localhost:6379/0
OBJECT_STORE_URL=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=nascon-storage
OBJECT_STORE_SECRET_KEY=nascon-storage-local

# Default: local receipt inbox at http://localhost:8080/local-mail. No credentials needed.
SMTP_DELIVERY_MODE=local
SMTP_HOST=local-mail
SMTP_PORT=1025
SMTP_FROM=receipts@arenaone.local
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465), or none (local test SMTP only)
SMTP_TLS_MODE=none
SMTP_TIMEOUT=10
# Optional receipt label for demo accounts; local mode also accepts the .test account address.
DEMO_RECEIPT_EMAIL=
